#!/usr/bin/env bash

set -euo pipefail

POD_NAME="secrets-manager-openbao-0"
NAMESPACE="secrets-manager"

echo "Waiting for pod '$POD_NAME' in namespace '$NAMESPACE' to be ready..."
while ! kubectl get pod "$POD_NAME" -n "$NAMESPACE" &> /dev/null; do
    sleep 2
done

echo "Waiting for the pod to be running..."
kubectl wait --for=jsonpath='{.status.phase}'=Running pod/$POD_NAME -n $NAMESPACE --timeout=120s

echo "Waiting for the secrets manager to start accepting connections..."
while ! { kubectl exec -n "$NAMESPACE" "$POD_NAME" -- bao status 2>&1 || true; } | grep -q "Initialized"; do
    sleep 2
done

echo "Initializing secrets manager..."
INIT_OUTPUT=$(kubectl exec -n $NAMESPACE $POD_NAME -- bao operator init)

KEY1=$(echo "$INIT_OUTPUT" | grep -iE "(Recovery) Key 1:" | awk '{print $NF}')
KEY2=$(echo "$INIT_OUTPUT" | grep -iE "(Recovery) Key 2:" | awk '{print $NF}')
KEY3=$(echo "$INIT_OUTPUT" | grep -iE "(Recovery) Key 3:" | awk '{print $NF}')
KEY4=$(echo "$INIT_OUTPUT" | grep -iE "(Recovery) Key 4:" | awk '{print $NF}')
KEY5=$(echo "$INIT_OUTPUT" | grep -iE "(Recovery) Key 5:" | awk '{print $NF}')
ROOT_TOKEN=$(echo "$INIT_OUTPUT" | grep "Initial Root Token:" | awk '{print $NF}')

echo ""
echo "=================================================="
echo "             OPENBAO SETUP COMPLETE"
echo "=================================================="
echo "CRITICAL: Store these keys in a secure location."
echo "They will not be displayed again."
echo ""
echo "Recovery Key 1: $KEY1"
echo "Recovery Key 2: $KEY2"
echo "Recovery Key 3: $KEY3"
echo "Recovery Key 4: $KEY4"
echo "Recovery Key 5: $KEY5"
echo "Initial Root Token: $ROOT_TOKEN"

echo "=== Bootstrapping tofu ==="
./scripts/init-k8s-tofu "$ROOT_TOKEN"

